-# app/views/shared/_currency_badges.html.haml
- currencies = local_assigns.fetch(:currencies, [])
- compact = local_assigns.fetch(:compact, false)

= turbo_frame_tag "currency_balances" do
  - if currencies.any?
    - wrapper_classes = ["flex", "items-center", "space-x-3"]
    - badge_classes = ["bg-slate-100", "border", "border-slate-200", "rounded-full", "py-1", "px-3", "text-sm", "font-medium", "flex", "items-center", "space-x-2"]
    - if compact
      - wrapper_classes = ["flex", "items-center", "space-x-2"]
      - badge_classes = ["bg-slate-100", "border", "border-slate-200", "rounded-full", "py-0.5", "px-2.5", "text-xs", "font-semibold", "flex", "items-center", "space-x-1.5"]
    %div{ class: wrapper_classes.join(' ') }
      - currencies.each do |currency|
        %div{ class: badge_classes.join(' ') }
          %span.text-slate-500= currency.name
          %span.text-slate-900= number_with_delimiter(currency.amount)
  - else
    %div.hidden
